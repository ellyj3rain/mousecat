{
  "hostProfile": "local-dev",
  "upstreams": {
    "neo": { "enabled": true },
    "github": { "enabled": true },
    "z-library": { "enabled": false },
    "codex": { "enabled": true },
    "claude": { "enabled": true },
    "browser": { "enabled": true },
    "jetbrains": { "enabled": true },
    "cursor": { "enabled": true },
    "custom": { "enabled": true }
  },
  "credentials": {
    "policy": "references-only"
  },
  "connectors": {
    "neo": {
      "enabled": false,
      "kind": "external-mcp",
      "transport": "stdio",
      "command": "node",
      "args": ["<private-neo-root>/core/mcp/server.js"],
      "cwd": "<private-neo-root>",
      "timeoutMs": 10000
    }
  }
}
