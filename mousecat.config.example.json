{
  "hostProfile": "local-dev",
  "adapterProfile": "generic-mcp",
  "upstreams": {
    "neo": { "enabled": true },
    "github": { "enabled": true },
    "gitlab": { "enabled": false },
    "z-library": { "enabled": false },
    "codex": { "enabled": true },
    "claude": { "enabled": true },
    "browser": { "enabled": true },
    "jetbrains": { "enabled": true },
    "cursor": { "enabled": true },
    "custom": { "enabled": true }
  },
  "credentials": {
    "policy": "references-only"
  },
  "state": {
    "enabled": false,
    "path": ".mousecat/state.json",
    "maxEvents": 500,
    "maxRoutePlans": 100
  },
  "connectors": {
    "neo": {
      "enabled": false,
      "kind": "external-mcp",
      "transport": "http",
      "url": "http://127.0.0.1:7473/mcp",
      "tokenEnv": "NEO_RUNTIME_TOKEN",
      "timeoutMs": 10000,
      "cancellationGraceMs": 1000
    },
    "gitlab": {
      "enabled": false,
      "kind": "integration-adapter",
      "transport": "cli-json",
      "adapter": "gitlab-v4",
      "executablePath": "/absolute/path/to/glab",
      "executableSha256": "sha256-of-approved-glab-binary",
      "defaultProject": "namespace/project",
      "hostname": "gitlab.example.com",
      "timeoutMs": 10000
    }
  }
}
