{
  "name": "mousecat",
  "version": "0.1.0",
  "description": "One MCP server for governed operator interaction, skill-framework routing, live visualization, and tool-boundary control.",
  "type": "module",
  "bin": {
    "mousecat": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test",
    "verify": "npm test && npm run test:github-scripts && npm run smoke:status && npm run smoke:buttons && npm run smoke:connectors && npm run smoke:mcp",
    "pr:ready": "npm run verify && npm run governance:floor && npm run governance:ceiling && npm run docs:check && npm run hygiene:strict",
    "ci:verify": "npm run pr:ready",
    "test:github-scripts": "node --test .github/scripts/check-pr-chronology.test.mjs .github/scripts/check-pr-shape.test.mjs",
    "pr:shape": "node .github/scripts/check-pr-shape.mjs",
    "governance:floor": "node scripts/governance-floor.mjs",
    "governance:ceiling": "node scripts/governance-ceiling.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "hygiene:strict": "node scripts/hygiene-strict.mjs",
    "smoke:status": "node src/cli.mjs --config .github/mousecat.ci.config.json status",
    "smoke:buttons": "node src/cli.mjs --config .github/mousecat.ci.config.json buttons",
    "smoke:connectors": "node src/cli.mjs --config .github/mousecat.ci.config.json connectors",
    "smoke:mcp": "node src/cli.mjs --config .github/mousecat.ci.config.json mcp --self-test"
  },
  "keywords": [
    "mcp",
    "operator-ui",
    "agent-tools",
    "work-permits",
    "skill-frameworks"
  ],
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CORE.md",
    "ARCHITECTURE.md",
    "GOVERNANCE.md",
    "ROADMAP.md",
    "VERSION"
  ]
}
